{
  "manifest_version": 3,
  "name": "vios",
  "version": "0.1.0",
  "description": "Vim-like keyboard navigation and utilities",
  "permissions": ["tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
