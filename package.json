{
  "name": "vios",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @vios/chrome build",
    "dev": "pnpm --filter @vios/chrome dev",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
